# ==============================================================================
# 🚀 ENV TEMPLATE UNTUK DEPLOYMENT V PRODUCTION (DOKPLOY / VPS)
# Project: Portal FMIKOM
# ==============================================================================
# Catatan Keamanan Penting:
# 1. SALIN file ini ke pengaturan Environment Variables di Dashboard Dokploy atau file .env di server.
# 2. JANGAN PERNAH meng-commit file .env asli yang berisi password/secret ke repository Git.
# 3. Keterangan Label:
#    - 🚨 [WAJIB DIUBAH]      : Harus diganti dengan nilai asli production (Keamanan & Fungsi Utama).
#    - ⚠️ [PERLU DISESUAIKAN] : Disesuaikan dengan domain, host database, atau service VPS.
#    - 💡 [OPSIONAL/DEFAULT]  : Boleh biarkan default kecuali butuh integrasi fitur tertentu.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APLIKASI UTAMA (APP CONFIGURATION)
# ------------------------------------------------------------------------------
# ⚠️ Nama aplikasi yang muncul di email, title tab, dan notifikasi
APP_NAME="Portal FMIKOM"

# 🚨 [WAJIB DIUBAH] Set Wajib 'production' di VPS. Mengaktifkan optimasi & pengamanan.
APP_ENV=production

# ⚠️ Timezone Aplikasi (Asia/Jakarta untuk Indonesia WIB)
APP_TIMEZONE=Asia/Jakarta

# 🚨 [WAJIB DIUBAH] Application Encryption Key (32 karakter base64).
# Cara buat di lokal: jalankan `php artisan key:generate --show` lalu paste hasilnya di bawah.
# CONTOH: base64:x+Y9Z3k+... (GANTI DENGAN KUNCI UNIK ANDA!)
APP_KEY=

# 🚨 [WAJIB DIUBAH] Set WAJIB 'false' di Production! Jika true, error & credential sensitif bisa bocor ke publik.
APP_DEBUG=false

# 🚨 [WAJIB DIUBAH] URL lengkap aplikasi Anda di VPS (Wajib pakai https:// jika sudah ada SSL).
# Contoh: https://fmikom.domainanda.com atau https://portal.fmikom.id
APP_URL=https://fmikom.domainanda.com

# 💡 Bahas default aplikasi
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# 💡 Driver maintenance mode (file / database)
APP_MAINTENANCE_DRIVER=file

# ------------------------------------------------------------------------------
# 2. LOGGING & LOG MANAGEMENT
# ------------------------------------------------------------------------------
# ⚠️ Di production disarankan 'stack' (menulis log ke file storage/logs/laravel.log)
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null

# 🚨 [WAJIB DIUBAH] Di production atur ke 'error' atau 'warning' agar log tidak cepat memenuhi disk storage.
# Opsi: debug, info, notice, warning, error, critical, alert, emergency.
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# 3. DATABASE (MYSQL CONFIGURATION)
# ------------------------------------------------------------------------------
# ⚠️ Driver database yang digunakan
DB_CONNECTION=mysql

# ⚠️ [PERLU DISESUAIKAN] Host / Nama Service MySQL di Dokploy.
# - Jika pakai Docker Compose di Dokploy: `mysql` (sesuai nama service di docker-compose)
# - Jika pakai Dokploy Managed Database: isi nama internal container MySQL dari Dokploy (misal `dokploy-mysql`) atau IP VPS.
DB_HOST=mysql

# ⚠️ Port MySQL (default internal container: 3306)
DB_PORT=3306

# 🚨 [WAJIB DIUBAH] Nama database yang dibuat di MySQL
DB_DATABASE=fmikom_portal

# 🚨 [WAJIB DIUBAH] Username database
DB_USERNAME=fmikom_user

# 🚨 [WAJIB DIUBAH] Password database yang kuat & aman! (Jangan pakai password mudah/default)
DB_PASSWORD=GantiDenganPasswordDatabaseYangKuat123!

# 🚨 [WAJIB DIUBAH] Password root MySQL (diperlukan jika menggunakan docker-compose.prod.yml)
DB_ROOT_PASSWORD=GantiDenganPasswordRootMySQLYangSangatKuat456!

# ⚠️ Jalankan migrasi otomatis saat container dinyalakan pertama kali via docker/entrypoint.sh (true/false)
RUN_MIGRATIONS=true

# ------------------------------------------------------------------------------
# 4. REDIS CONFIGURATION (CACHE, QUEUE, & SESSION)
# ------------------------------------------------------------------------------
# ⚠️ Driver client PHP Redis
REDIS_CLIENT=phpredis

# ⚠️ [PERLU DISESUAIKAN] Host Redis.
# - Jika pakai Docker Compose di Dokploy: `redis`
# - Jika pakai Dokploy Managed Redis: nama container/hostname Redis di Dokploy.
REDIS_HOST=redis

# 🚨 [WAJIB DIUBAH] Password Redis di production (Kosongkan HANYA jika Redis diisolasi total dalam docker network internal).
REDIS_PASSWORD=

# ⚠️ Port Redis default
REDIS_PORT=6379
REDIS_PERSISTENT=true

# ------------------------------------------------------------------------------
# 5. CACHE, QUEUE, SESSION, & BROADCAST DRIVERS
# ------------------------------------------------------------------------------
# 🚨 [WAJIB DIUBAH] Gunakan 'database' untuk sesi agar aman & tidak gampang terhapus saat clear cache.
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database

# 💡 Prefix key cache agar tidak bentrok jika Redis dipakai oleh aplikasi lain
CACHE_PREFIX=fmikom_prod_cache_

# 💡 Storage driver untuk file upload pengguna (portofolio, foto profil, dokumen)
FILESYSTEM_DISK=local

# 💡 Broadcast driver (menggunakan 'reverb' jika WebSocket aktif)
BROADCAST_CONNECTION=reverb

# ------------------------------------------------------------------------------
# 6. ENKRIPSI & KEAMANAN SESI (SESSION & COOKIE SECURITY)
# ------------------------------------------------------------------------------
# ⚠️ Nama cookie session aplikasi
SESSION_COOKIE=fm_sess_prod

# ⚠️ Durasi idle session (dalam menit). Contoh: 30 menit
SESSION_LIFETIME=30

# ⚠️ Session otomatis hangus saat browser ditutup
SESSION_EXPIRE_ON_CLOSE=true

# 🚨 [WAJIB DIUBAH] Set 'true' untuk meng-enkripsi isi cookie session
SESSION_ENCRYPT=true
SESSION_PATH=/

# 🚨 [WAJIB DIUBAH] Biarkan kosong (SESSION_DOMAIN=) agar cookie mengikuti domain request otomatis.
SESSION_DOMAIN=

# 🚨 [WAJIB DIUBAH] WAJIB 'true' jika domain Anda sudah menggunakan HTTPS/SSL di VPS!
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ⚠️ Timeout absolut sesi user (dalam jam) diselesaikan oleh SecureSession Middleware
SESSION_ABSOLUTE_TIMEOUT_HOURS=8

# ⚠️ Cost faktor bcrypt (default 12 aman untuk production)
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# 7. LARAVEL REVERB (WEBSOCKETS REAL-TIME)
# ------------------------------------------------------------------------------
# 🚨 [WAJIB DIUBAH] Credential Reverb untuk WebSockets. Generate acak / unik!
REVERB_APP_ID=100800
REVERB_APP_KEY=fmikom-reverb-key-prod-99
REVERB_APP_SECRET=fmikom-reverb-secret-prod-8877

# ⚠️ Host internal server Reverb di dalam container
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SERVER_PORT=8080
REVERB_SCHEME=http

# 🚨 [WAJIB DIUBAH] Credential Reverb yang di-expose ke Frontend (Vite)
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"

# 🚨 [WAJIB DIUBAH] Domain WebSocket publik yang diakses frontend browser client.
# Jika dibalik Traefik/Dokploy SSL:
# VITE_REVERB_HOST=fmikom.domainanda.com
# VITE_REVERB_PORT=443
# VITE_REVERB_SCHEME=https
VITE_REVERB_HOST=fmikom.domainanda.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# ------------------------------------------------------------------------------
# 8. EMAIL / MAIL CONFIGURATION (SMTP / MAILGUN / SES)
# ------------------------------------------------------------------------------
# 🚨 [WAJIB DIUBAH] Driver email production (Gunakan 'smtp', 'mailgun', 'ses', atau 'resend')
MAIL_MAILER=smtp

# 🚨 [WAJIB DIUBAH] Detail server SMTP Anda (Contoh: Brevo / Mailtrap / SMTP VPS / Google Workspace)
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=username_smtp_anda
MAIL_PASSWORD=password_smtp_anda
MAIL_ENCRYPTION=tls

# 🚨 [WAJIB DIUBAH] Email dan Nama pengirim resmi notifikasi
MAIL_FROM_ADDRESS="no-reply@domainanda.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# 9. INTEGRASI PIHAK KETIGA & OAUTH
# ------------------------------------------------------------------------------
# 🚨 [WAJIB DIUBAH] Google OAuth Credentials (Untuk Login via Google)
# Dapatkan di Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Callback URI harus persis sama dengan yang terdaftar di Google Console
GOOGLE_REDIRECT_URI=https://fmikom.domainanda.com/auth/google/callback

# 💡 [OPSIONAL] Gemini AI / OpenRouter API Key (Jika menggunakan fitur AI)
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 10. STORAGE AMAN / AWS S3 (OPSIONAL)
# ------------------------------------------------------------------------------
# 💡 Isi jika FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------------------
# 11. MONITORING & DIAGNOSTIK
# ------------------------------------------------------------------------------
# 🚨 [WAJIB DIUBAH] Matikan Laravel Telescope di production demi keamanan & hemat memori!
TELESCOPE_ENABLED=false

# ⚠️ Nama server di Laravel Pulse dashboard
PULSE_SERVER_NAME=fmikom-vps-prod

# ------------------------------------------------------------------------------
# 12. UTILITY & SECURITY EXTENSIONS
# ------------------------------------------------------------------------------
# 💡 Path binary FFmpeg & FFprobe (Otomatis terinstall di container Alpine via Dockerfile)
FFMPEG_BINARIES=/usr/bin/ffmpeg
FFPROBE_BINARIES=/usr/bin/ffprobe

# 💡 Integrasi ClamAV Antivirus (Set true jika ada service clamav aktif)
CLAMAV_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# 💡 Cloudflare Tunnel Token (Kosongkan jika domain langsung menunjuk ke Traefik/Dokploy VPS)
CLOUDFLARE_TUNNEL_TOKEN=
